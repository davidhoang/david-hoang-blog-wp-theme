{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Dark",
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "text",
                    "color": "#e8e6e1",
                    "name": "Text"
                },
                {
                    "slug": "background",
                    "color": "#161614",
                    "name": "Background"
                },
                {
                    "slug": "muted",
                    "color": "#b0aea6",
                    "name": "Muted"
                },
                {
                    "slug": "surface",
                    "color": "#222220",
                    "name": "Surface"
                },
                {
                    "slug": "border",
                    "color": "#333330",
                    "name": "Border"
                },
                {
                    "slug": "chrome",
                    "color": "#1c1c1a",
                    "name": "Chrome"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--text)"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--text)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--muted)"
                    }
                }
            }
        },
        "blocks": {
            "core/quote": {
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--border)",
                        "width": "2px"
                    }
                }
            }
        }
    }
}
