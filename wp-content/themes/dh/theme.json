{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "palette": [
                {
                    "slug": "text",
                    "color": "#333333",
                    "name": "Text"
                },
                {
                    "slug": "background",
                    "color": "#ffffff",
                    "name": "Background"
                },
                {
                    "slug": "muted",
                    "color": "#666666",
                    "name": "Muted"
                },
                {
                    "slug": "surface",
                    "color": "#f7f7f7",
                    "name": "Surface"
                },
                {
                    "slug": "border",
                    "color": "#dddddd",
                    "name": "Border"
                },
                {
                    "slug": "chrome",
                    "color": "#f8f8f6",
                    "name": "Chrome"
                }
            ]
        },
        "layout": {
            "contentSize": "46rem",
            "wideSize": "80rem"
        },
        "spacing": {
            "units": ["%", "px", "em", "rem", "vh", "vw"]
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Newsreader', Georgia, 'Times New Roman', serif",
                    "slug": "newsreader",
                    "name": "Newsreader"
                }
            ],
            "fontSizes": [
                {
                    "slug": "xs",
                    "size": "0.8125rem",
                    "name": "Extra small"
                },
                {
                    "slug": "sm",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "ui",
                    "size": "0.95rem",
                    "name": "UI"
                },
                {
                    "slug": "md",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "body",
                    "size": "1.125rem",
                    "name": "Body"
                },
                {
                    "slug": "lg",
                    "size": "1.35rem",
                    "name": "Large"
                },
                {
                    "slug": "xl",
                    "size": "2rem",
                    "name": "Extra large"
                },
                {
                    "slug": "lede",
                    "size": "clamp(1.125rem, 1.8vw, 1.65rem)",
                    "name": "Lede"
                },
                {
                    "slug": "display",
                    "size": "clamp(2.35rem, 4.2vw, 4.75rem)",
                    "name": "Display"
                },
                {
                    "slug": "hero",
                    "size": "clamp(4rem, 8.5vw, 8.5rem)",
                    "name": "Hero"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--text)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--newsreader)",
            "fontSize": "var(--wp--preset--font-size--body)",
            "lineHeight": "1.7"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--text)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--muted)"
                    }
                }
            },
            "heading": {
                "typography": {
                    "fontWeight": "500",
                    "lineHeight": "1.1"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--display)",
                    "lineHeight": "0.96",
                    "letterSpacing": "-0.035em"
                }
            }
        },
        "blocks": {
            "core/quote": {
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--border)",
                        "width": "2px"
                    }
                },
                "spacing": {
                    "padding": {
                        "left": "1.25rem"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--lg)"
                }
            },
            "core/button": {
                "border": {
                    "radius": "0"
                }
            }
        }
    }
}
